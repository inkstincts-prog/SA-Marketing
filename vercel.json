{
  "buildCommand": "echo 'Static site - no build needed'",
  "outputDirectory": ".",
  "public": false,
  "env": {
    "ASSET_PATH": "/assets"
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
